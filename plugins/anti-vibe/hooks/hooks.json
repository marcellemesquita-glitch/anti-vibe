{
  "description": "Ganchos do anti-vibe: regras e estado do trabalho no início da sessão; portão de conclusão do diagnóstico e do executor.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/sessao.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/portao.mjs"
            ],
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^anti-vibe:(diagnostico|executor)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/portao.mjs"
            ],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
